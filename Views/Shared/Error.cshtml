@model ErrorViewModel

@{
    ViewData["Title"] = "Error del Sistema";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0">

                <div class="card-body text-center p-5">

                    <!-- ICONO -->
                    <div class="mb-4">

                        <i class="bi bi-exclamation-triangle-fill
                                  text-danger"
                           style="font-size: 80px;">
                        </i>

                    </div>

                    <!-- TITULO -->
                    <h1 class="text-danger fw-bold">

                        Error del Sistema

                    </h1>

                    <!-- MENSAJE -->
                    <h4 class="text-secondary mt-3">

                        Ocurrió un error mientras se procesaba la solicitud.

                    </h4>

                    <hr class="my-4" />

                    <!-- REQUEST ID -->
                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border">

                            <strong>Request ID:</strong>

                            <code>@Model.RequestId</code>

                        </div>
                    }

                    <!-- MENSAJE INFORMATIVO -->
                    <div class="alert alert-warning mt-4">

                        <strong>Modo Desarrollo:</strong>

                        Para visualizar detalles técnicos del error,
                        configure la variable:

                        <code>
                            ASPNETCORE_ENVIRONMENT=Development
                        </code>

                    </div>

                    <!-- BOTON -->
                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="btn btn-dark mt-3">

                        <i class="bi bi-house-fill"></i>

                        Volver al Inicio

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>  